{
  "name": "@livon/client",
  "version": "0.29.0-rc.11",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "rslib build",
    "build:watch": "rslib dev",
    "dev": "rslib dev",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --configLoader runner -c vitest.integration.config.ts",
    "test:unit": "vitest run --configLoader runner -c vitest.unit.config.ts",
    "test:integration": "vitest run --passWithNoTests --configLoader runner -c vitest.integration.config.ts"
  },
  "devDependencies": {
    "@livon/vitest": "workspace:*",
    "@livon/eslint": "workspace:*",
    "@livon/rslib": "workspace:*",
    "@livon/typescript": "workspace:*",
    "@types/node": "latest"
  },
  "description": "Client runtime and generated client foundations for LIVON.",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./generate": {
      "types": "./dist/generate.d.ts",
      "import": "./dist/generate.js",
      "require": "./dist/generate.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "license": "MIT",
  "author": {
    "name": "LIVON",
    "url": "https://livon.tech"
  },
  "contributors": [
    {
      "name": "cr15p1",
      "url": "https://github.com/cr15p1"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/live-input-vector-output-node/livon-ts.git",
    "directory": "packages/client"
  },
  "homepage": "https://livon.tech/docs/packages/client",
  "bugs": {
    "url": "https://github.com/live-input-vector-output-node/livon-ts/issues"
  },
  "keywords": [
    "livon",
    "client",
    "api",
    "codegen",
    "typescript"
  ],
  "dependencies": {
    "@livon/runtime": "workspace:*"
  },
  "peerDependencies": {}
}
