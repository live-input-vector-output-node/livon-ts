    "./entry": "./src/entry.ts",
    "./library": "./src/library.ts",
    "./compose": "./src/compose.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@livon/typescript": "workspace:*",
    "@types/node": "latest",
    "typescript": "latest",
    "@rslib/core": "latest"
  }
}
