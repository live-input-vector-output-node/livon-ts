{
  "extends": [
    "@livon/typescript/base",
    "@livon/typescript/browser",
    "@livon/typescript/react"
  ],
  "include": [
    "src",
    ".livon/generated",
    "*.config.ts"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@livon/generated": [
        ".livon/generated/client.ts"
      ]
    }
  },
  "exclude": [
    "dist",
    "node_modules"
  ]
}
